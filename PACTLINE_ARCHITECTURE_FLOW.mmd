    class PROXY,API,VALIDATE,ORCH,INVOICE,HOLD,HUMAN,REJECT,REAUTHORIZE,CONTINUE,EFFECT backend;
    class SDKADAPTER,SDK,INTENT,MCP,TOOLS,DECIDE armor;
    class STORE data;
